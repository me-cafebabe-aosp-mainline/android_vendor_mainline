cc_binary {
    name: "bootsplash",
    srcs: [
        "main.cpp",
        "render.cpp",
        "drm.cpp",
        "fbdev.cpp",
    ],
    shared_libs: [
        "libbase",
        "libdrm",
        "libft2",
        "libpng",
        "libyuv",
    ],
    init_rc: select(soong_config_variable("bootsplash", "use_minimal_init_rc"), {
        true: ["bootsplash_minimal.rc"],
        default: ["bootsplash.rc"],
    }),
    system_ext_specific: true,
    bootstrap: true,
}
