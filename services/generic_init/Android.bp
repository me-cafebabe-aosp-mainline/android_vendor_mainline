// LINT.IfChange
// N.B. keep this in sync with EXPORT_GLOBAL_HWASAN_OPTIONS in system/core/rootdir/Android.bp
GLOBAL_HWASAN_OPTIONS = select(soong_config_variable("ANDROID", "HWASAN_ENABLED"), {
    true: ["-DHWASAN_OPTIONS=heap_history_size=1023,stack_history_size=512,export_memory_stats=0,max_malloc_fill_size=131072,malloc_fill_byte=0"],
    default: [],
})
// LINT.ThenChange(/rootdir/Android.bp)

init_common_sources = [
    "action.cpp",
    "action_manager.cpp",
    "action_parser.cpp",
    "capabilities.cpp",
    "epoll.cpp",
    "import_parser.cpp",
    "interprocess_fifo.cpp",
    "keychords.cpp",
    "parser.cpp",
    "property_type.cpp",
    "rlimit_parser.cpp",
    "service.cpp",
    "service_list.cpp",
    "service_parser.cpp",
    "service_utils.cpp",
    "subcontext.cpp",
    "subcontext.proto",
    "tokenizer.cpp",
    "util.cpp",
]
init_device_sources = [
    "apex_init_util.cpp",
    "block_dev_initializer.cpp",
    "bootchart.cpp",
    "builtins.cpp",
    "coldboot.cpp",
    "coldboot_runner_noparallel.cpp",
    "coldboot_runner_subprocess.cpp",
    "coldboot_runner_thread_pool.cpp",
    "devices.cpp",
    "firmware_handler.cpp",
    "first_stage_console.cpp",
    "fscrypt_init_extensions.cpp",
    "init.cpp",
    "lmkd_service.cpp",
    "modalias_handler.cpp",
    "mount_handler.cpp",
    "mount_namespace.cpp",
    "ota_utils.cpp",
    "persistent_properties.cpp",
    "persistent_properties.proto",
    "property_service.cpp",
    "property_service.proto",
    "reboot.cpp",
    "reboot_utils.cpp",
    "security.cpp",
    "selabel.cpp",
    "selinux.cpp",
    "sigchld_handler.cpp",
    "snapuserd_transition.cpp",
    "switch_root.cpp",
    "tradeinmode.cpp",
    "thread_pool.cpp",
    "uevent_listener.cpp",
    "uevent_dependency_graph.cpp",
    "ueventd.cpp",
    "ueventd_parser.cpp",
]

soong_config_module_type {
    name: "libgeneric_init_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "ANDROID",
    bool_variables: [
        "PRODUCT_INSTALL_DEBUG_POLICY_TO_SYSTEM_EXT",
        "release_write_appcompat_override_system_properties",
        "release_deprecate_runtime_apex",
    ],
    properties: [
        "cflags",
    ],
}

libgeneric_init_cc_defaults {
    name: "generic_init_defaults",
    sanitize: {
        misc_undefined: ["signed-integer-overflow"],
    },
    cflags: [
        "-DALLOW_FIRST_STAGE_CONSOLE=0",
        "-DALLOW_LOCAL_PROP_OVERRIDE=0",
        "-DALLOW_PERMISSIVE_SELINUX=0",
        "-DANDROID_BASE_UNIQUE_FD_DISABLE_IMPLICIT_CONVERSION",
        "-DDUMP_ON_UMOUNT_FAILURE=0",
        "-DINIT_FULL_SOURCES",
        "-DINSTALL_DEBUG_POLICY_TO_SYSTEM_EXT=0",
        "-DLOG_UEVENTS=0",
        "-DREBOOT_BOOTLOADER_ON_PANIC=0",
        "-DSHUTDOWN_ZERO_TIMEOUT=0",
        "-DWORLD_WRITABLE_KMSG=0",
        "-DHAVE_LIBUNWIND",
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wthread-safety",
    ],
    product_variables: {
        debuggable: {
            cppflags: [
                "-UALLOW_FIRST_STAGE_CONSOLE",
                "-DALLOW_FIRST_STAGE_CONSOLE=1",
                "-UALLOW_LOCAL_PROP_OVERRIDE",
                "-DALLOW_LOCAL_PROP_OVERRIDE=1",
                "-UALLOW_PERMISSIVE_SELINUX",
                "-DALLOW_PERMISSIVE_SELINUX=1",
                "-UREBOOT_BOOTLOADER_ON_PANIC",
                "-DREBOOT_BOOTLOADER_ON_PANIC=1",
                "-UWORLD_WRITABLE_KMSG",
                "-DWORLD_WRITABLE_KMSG=1",
                "-UDUMP_ON_UMOUNT_FAILURE",
                "-DDUMP_ON_UMOUNT_FAILURE=1",
                "-UALLOW_REMOUNT_OVERLAYS",
                "-DALLOW_REMOUNT_OVERLAYS=1",
            ],
        },
        eng: {
            cppflags: [
                "-USHUTDOWN_ZERO_TIMEOUT",
                "-DSHUTDOWN_ZERO_TIMEOUT=1",
            ],
        },
        uml: {
            cppflags: ["-DUSER_MODE_LINUX"],
        },
    },
    soong_config_variables: {
        PRODUCT_INSTALL_DEBUG_POLICY_TO_SYSTEM_EXT: {
            cflags: [
                "-UINSTALL_DEBUG_POLICY_TO_SYSTEM_EXT",
                "-DINSTALL_DEBUG_POLICY_TO_SYSTEM_EXT=1",
            ],
        },
        release_write_appcompat_override_system_properties: {
            cflags: ["-DWRITE_APPCOMPAT_OVERRIDE_SYSTEM_PROPERTIES"],
        },
        release_deprecate_runtime_apex: {
            cflags: ["-DRELEASE_DEPRECATE_RUNTIME_APEX"],
        },
    },
    static_libs: [
        "libapexd_flags",
        "libinit_flags",
        "libavb",
        "libavf_cc_flags",
        "libbootloader_message",
        "liblmkd_utils",
        "liblz4",
        "liblzma",
        "libmodprobe",
        "libprocinfo",
        "libprotobuf-cpp-lite",
        "libpropertyinfoserializer",
        "libpropertyinfoparser",
        "libsnapshot_cow",
        "libsnapshot_init",
        "libxml2",
        "update_metadata-protos",
        "libgenfslabelsversion.ffi",
    ] + select(soong_config_variable("generic_init", "enabled"), {
        true: ["libzstd"],
        default: [],
    }),
    shared_libs: [
        "libbase",
        "libcutils",
        "libdl",
        "libext4_utils",
        "libfs_mgr",
        "libgsi",
        "liblog",
        "liblogwrap",
        "liblp",
        "libprocessgroup",
        "libprocessgroup_setup",
        "libselinux",
        "libunwindstack",
        "libutils",
        "libvendorsupport",
    ],
    header_libs: [
        "libupdate_engine_headers",
    ],
    bootstrap: true,
    visibility: [":__subpackages__"],
    enabled: select(soong_config_variable("generic_init", "enabled"), {
        true: true,
        default: false,
    }),
}

cc_defaults {
    name: "libgeneric_init_defaults",
    recovery_available: true,
    defaults: [
        "generic_init_defaults",
        "selinux_policy_version",
    ],
    srcs: init_common_sources + init_device_sources,
    export_include_dirs: ["."],
    generated_sources: [
        "apex-info-list",
    ],
    whole_static_libs: [
        "libcap",
    ],
    header_libs: ["bootimg_headers"],
    proto: {
        type: "lite",
        export_proto_headers: true,
    },
    static_libs: [
        "libinit_flags",
        "libueventd_flags",
    ],

    target: {
        recovery: {
            cflags: ["-DRECOVERY"],
            exclude_static_libs: [
                "libxml2",
            ],
            exclude_generated_sources: [
                "apex-info-list",
            ],
            exclude_shared_libs: [
                "libbinder",
                "libutils",
            ],
        },
    },
}

cc_library_static {
    name: "libgeneric_init",
    defaults: ["libgeneric_init_defaults"],
}

cc_defaults {
    name: "generic_init_second_stage_defaults",
    stem: "generic_init",
    defaults: ["generic_init_defaults"],
    srcs: ["main.cpp"],
}

cc_binary {
    name: "generic_init_second_stage.recovery",
    defaults: ["generic_init_second_stage_defaults"],
    static_libs: ["libgeneric_init"],
    recovery: true,
    cflags: ["-DRECOVERY"],
    exclude_static_libs: [
        "libxml2",
    ],
    exclude_shared_libs: [
        "libbinder",
        "libutils",
    ],
    srcs: [
        "dynamic_mount_handler.cpp",
        "dynamic_mount_helpers.cpp",
        "first_stage_init.cpp",
        "first_stage_mount.cpp",
        "first_stage_mount_android.cpp",
        "iso_file.cpp",
        "loop_device.cpp",
        "partition_table.cpp",
        "resize_fs.cpp",
        "usb_gadget.cpp",
        "ventoy_image.cpp",
    ],
}

cc_defaults {
    name: "generic_init_first_stage_defaults",
    stem: "generic_init",

    srcs: [
        "block_dev_initializer.cpp",
        "devices.cpp",
        "first_stage_console.cpp",
        "first_stage_init.cpp",
        "first_stage_main.cpp",
        "first_stage_mount.cpp",
        "ota_utils.cpp",
        "reboot_utils.cpp",
        "selabel.cpp",
        "service_utils.cpp",
        "switch_root.cpp",
        "uevent_listener.cpp",
        "util.cpp",
    ] + [
        "coldboot.cpp",
        "coldboot_runner_noparallel.cpp",
        "coldboot_runner_subprocess.cpp",
        "coldboot_runner_thread_pool.cpp",
        "devices.cpp",
        "dynamic_mount_handler.cpp",
        "dynamic_mount_helpers.cpp",
        "firmware_handler.cpp",
        "import_parser.cpp",
        "modalias_handler.cpp",
        "parser.cpp",
        "thread_pool.cpp",
        "tokenizer.cpp",
        "uevent_dependency_graph.cpp",
        "uevent_listener.cpp",
        "ueventd.cpp",
        "ueventd_parser.cpp",
        "util.cpp",
        "iso_file.cpp",
        "loop_device.cpp",
        "partition_table.cpp",
        "resize_fs.cpp",
        "usb_gadget.cpp",
        "ventoy_image.cpp",
    ],

    static_libs: [
        "libapexd_flags",
        "libfs_avb",
        "libavf_cc_flags",
        "libfs_mgr",
        "libfec",
        "libfec_rs",
        "libcrypto_utils",
        "libavb",
        "libcutils",
        "libbase",
        "liblog",
        "libcrypto_static",
        "libselinux",
        "libcap",
        "liblzma",
        "libmodprobe",
        "libext2_uuid",
        "libz",
        "libprocinfo",
        "libbootloader_message",
    ] + [
        "libinit_flags",
        "libueventd_flags",
    ],
    proto: {
        type: "lite",
        export_proto_headers: true,
    },

    header_libs: [
        "libupdate_engine_headers",
    ],

    static_executable: true,
    ldflags: [
        "-Wl,--image-base=0x200000",
    ],
    system_shared_libs: [],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wno-exit-time-destructors",
        "-Werror",
        "-DALLOW_FIRST_STAGE_CONSOLE=0",
        "-DALLOW_LOCAL_PROP_OVERRIDE=0",
        "-DALLOW_PERMISSIVE_SELINUX=0",
        "-DFIRST_STAGE_INIT=1",
        "-DREBOOT_BOOTLOADER_ON_PANIC=0",
        "-DWORLD_WRITABLE_KMSG=0",
        "-DDUMP_ON_UMOUNT_FAILURE=0",
        "-DSHUTDOWN_ZERO_TIMEOUT=0",
        "-DLOG_UEVENTS=0",
        "-DSEPOLICY_VERSION=30", // TODO(jiyong): externalize the version number
    ] + GLOBAL_HWASAN_OPTIONS,

    product_variables: {
        debuggable: {
            cflags: [
                "-UALLOW_FIRST_STAGE_CONSOLE",
                "-DALLOW_FIRST_STAGE_CONSOLE=1",

                "-UALLOW_LOCAL_PROP_OVERRIDE",
                "-DALLOW_LOCAL_PROP_OVERRIDE=1",

                "-UALLOW_PERMISSIVE_SELINUX",
                "-DALLOW_PERMISSIVE_SELINUX=1",

                "-UREBOOT_BOOTLOADER_ON_PANIC",
                "-DREBOOT_BOOTLOADER_ON_PANIC=1",

                "-UWORLD_WRITABLE_KMSG",
                "-DWORLD_WRITABLE_KMSG=1",

                "-UDUMP_ON_UMOUNT_FAILURE",
                "-DDUMP_ON_UMOUNT_FAILURE=1",
            ],
        },

        eng: {
            cflags: [
                "-USHUTDOWN_ZERO_TIMEOUT",
                "-DSHUTDOWN_ZERO_TIMEOUT=1",
            ],
        },
    },

    sanitize: {
        misc_undefined: ["signed-integer-overflow"],

        // First stage init is weird: it may start without stdout/stderr, and no /proc.
        hwaddress: false,
        memtag_stack: false,
    },

    ramdisk: true,
}

cc_binary {
    name: "generic_init_first_stage",
    defaults: ["generic_init_first_stage_defaults"],
    srcs: [
        "first_stage_mount_android.cpp",
        "snapuserd_transition.cpp",
    ],
    static_libs: [
        "libgsi",
        "liblp",
        "liblz4",
        "libprotobuf-cpp-lite",
        "libsnapshot_cow",
        "libsnapshot_init",
        "update_metadata-protos",
    ] + select(soong_config_variable("generic_init", "enabled"), {
        true: ["libzstd"],
        default: [],
    }),
}
